{
  "family": "RENDER_REQUIRED",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {"operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64"},
  "executionRoleArn": "RENDER_REQUIRED",
  "containerDefinitions": [{
    "name": "api",
    "image": "RENDER_REQUIRED",
    "essential": true,
    "portMappings": [{"containerPort": 8000, "protocol": "tcp"}],
    "environment": [],
    "healthCheck": {
      "command": ["CMD", "python", "-S", "-c", "import socket,sys; s=socket.create_connection(('127.0.0.1',8000),4); s.sendall(b'GET /health HTTP/1.0\\r\\n\\r\\n'); sys.exit(0 if s.makefile('rb').readline().split()[1:2]==[b'200'] else 1)"],
      "interval": 30, "timeout": 10, "retries": 3, "startPeriod": 30
    },
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {"awslogs-group": "RENDER_REQUIRED", "awslogs-region": "RENDER_REQUIRED", "awslogs-stream-prefix": "api"}
    }
  }]
}
